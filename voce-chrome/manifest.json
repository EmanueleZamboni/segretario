{
  "manifest_version": 3,
  "name": "Segretario · Voce",
  "version": "1.0.15",
  "description": "La Voce del Segretario sopra la chat Secretary di claude.ai: parli, lui risponde a voce, con la scena. Un tasto e torni alla chat normale.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://hub.emazamboni.com/*",
    "http://127.0.0.1:8768/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "overlay.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
